# Build outputs
*.o
*.d
/astrolog
/astrolog-qt
/astrolog-qt6
/obj-qt/
/obj-qt6/
/obj-qt6-test/

# JetBrains IDE project files
.idea/
/astrolog-qt-test
/astrolog-qt-asan
# The UBSan artifacts had no entries at all, which is how a 12.7 MB
# astrolog-ubsan reached a commit: tools/ubsan-sweep.sh builds it, "make
# clean-console" does not remove it, and one "git add -A" swept it in.
/astrolog-ubsan
/astrolog-qt-ubsan
/obj-qt-ubsan/

# The coverage build, same hazard one step further: tools/coverage-report.sh
# builds ./astrolog-cov with --coverage and removes it at the end, so it
# survives only an interrupted run -- which is exactly when someone types
# "git add -A". The .gcno files it emits beside every object survive the
# same way, and .gcda are written by running it.
/astrolog-cov
*.gcda
*.gcno
# tools/asan-sweep.sh builds into /tmp; this is the name a by-hand
# "make NAME=astrolog-asan" leaves behind.
/astrolog-asan
/obj-qt-test/
/obj-qt-asan/
obj-win/
astrolog.exe
obj-wcli/
/astrolog-wcli.exe

# Comparison captures (tools/text-chart-capture.sh, text-chart-diff.py)
/out/

# Editor swap files
*.swp
*.swo
*~
/astrolog-qt-dbg
/obj-qt-dbg/
/base-astrolog
/astrolog-qt6-test
/tools/__pycache__/

# Baseline binaries built from an older commit for tools/*-matrix.sh
# differentials. They belong in a worktree or /nvm/work, never here --
# one reached a commit through "git add -A" (see the commit removing it).
astrolog-base
astrolog-qt-base
