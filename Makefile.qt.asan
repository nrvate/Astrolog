# Astrolog (Version 8.00) File: Makefile.qt.asan
#
# Builds "astrolog-qt-asan": the test suite of Makefile.qt.test compiled
# with AddressSanitizer, at -O0 -g so the reports name real lines. Its own
# name and object directory, so it never clobbers either other build.
#
# Run it directly rather than through run-qt-tests.sh, and cap it:
#
#   make -f Makefile.qt.asan -j4
#   env -u DISPLAY QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME= \
#     ASAN_OPTIONS=detect_leaks=0 timeout 600 ./astrolog-qt-asan -i nrvate.as
#
# detect_leaks=0 because Qt does not free everything at exit and the leak
# report buries real findings. Minutes, not seconds. It has found four
# out-of-bounds bugs in Astrolog's own chart code so far, all silent
# without it. See "Finding memory bugs" in QT_TESTING.md.
#
NAME = astrolog-qt-asan
OBJDIR = obj-qt-asan
# The source list lives in one file for all five builds; see the header
# there before adding a source.
include Makefile.srcs
OBJS = $(patsubst %.cpp,$(OBJDIR)/%.o,\
  $(SRC_CORE) $(SRC_GRAPHICS) $(SRC_QT) $(SRC_TEST) $(SRC_SWISS))

# Build against whichever Qt this machine has: Qt6 when pkg-config knows
# about it, Qt5 otherwise. One command works on a stock Ubuntu (Qt5), on a
# newer distro, and on a CI runner with either -- which is the point, since
# the alternative is a build matrix that doubles CI time to prove something
# the version guards in qtdriver.cpp already handle.
#
# Override with "make -f Makefile.qt.asan QT_MAJOR=5" to force one. A hand-installed
# Qt6 sits outside the default pkg-config path, so it is opt-in:
# PKG_CONFIG_PATH=/usr/local/qt6/lib/pkgconfig selects it.
#
# Qt5Test/Qt6Test is listed because it always has been; nothing in this
# tree includes <QtTest> and the linker drops it, so it costs an include
# path and nothing else.
QT_MAJOR := $(shell pkg-config --exists Qt6Widgets && echo 6 || echo 5)
QT_MODULES = Qt$(QT_MAJOR)Widgets Qt$(QT_MAJOR)Gui Qt$(QT_MAJOR)Core \
 Qt$(QT_MAJOR)PrintSupport Qt$(QT_MAJOR)Network
# The same guard Makefile.qt carries; the reasoning is there.
QT_NEEDED := $(if $(MAKECMDGOALS),$(filter-out clean,$(MAKECMDGOALS)),default)
ifneq ($(QT_NEEDED),)
QT_FOUND := $(shell pkg-config --exists $(QT_MODULES) 2>/dev/null && echo yes)
ifneq ($(QT_FOUND),yes)
$(error Qt development files not found. pkg-config cannot find: \
$(strip $(foreach m,$(QT_MODULES),\
$(if $(shell pkg-config --exists $(m) 2>/dev/null && echo y),,$(m)))). \
On Debian/Ubuntu: sudo apt install \
$(if $(filter 6,$(QT_MAJOR)),qt6-base-dev,qtbase5-dev). If Qt is installed \
somewhere pkg-config does not look, set PKG_CONFIG_PATH to the \
directory holding its .pc files. See CLAUDE.md, "Prerequisites")
endif
endif

QT_CFLAGS = $(shell pkg-config --cflags $(QT_MODULES) 2>/dev/null)
QT_LIBS = $(shell pkg-config --libs $(QT_MODULES) 2>/dev/null)
LIBS = $(QT_LIBS) -lm -ldl -fsanitize=address
CPPFLAGS = -MMD -MP -DQT -DQTTEST -fsanitize=address -g -O0 -fPIC -std=gnu++17 -Wno-write-strings -Wno-narrowing \
 -Wno-comment $(QT_CFLAGS)
RM = rm -f

$(NAME): $(OBJS)
	g++ -o $(NAME) $(OBJS) $(LIBS)

$(OBJDIR):
	mkdir -p $(OBJDIR)

# qtdialog.cpp includes the generated dialog tables; without this the
# object file survives a regeneration and the change appears to do nothing.

# Same reason for the generated accelerator table: without this the
# object file survives a regeneration and the change looks inert.


# "| $(OBJDIR)" is an ORDER-ONLY prerequisite, and it has to be here
# rather than on $(NAME). Listing $(OBJDIR) among $(NAME)'s ordinary
# prerequisites does not order it before the objects: under -j make is
# free to start compiling into a directory the mkdir has not created
# yet, and "make clean-all && make all -j4" did exactly that --
# "Fatal error: can't create obj-qt-test/sweph.o: No such file or
# directory". Makefile.win had it right all along.
$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
	g++ $(CPPFLAGS) -c -o $@ $<

clean:
	$(RM) -r $(OBJDIR)
	$(RM) $(NAME)
#

# Header dependencies are generated by the compiler, not maintained by
# hand. "-MMD -MP" writes a .d file beside each object listing every header
# it actually included, and the "-include" below feeds them back in.
#
# The hand-written version tracked exactly two headers, astrolog.h and
# extern.h, so touching swephexp.h rebuilt NOTHING and left
# objects that did not match their source -- measured, not supposed. That
# is the stale-binary class CLAUDE.md warns about ("if a check claims to
# have rebuilt something, look at the binary's timestamp"), with no check
# to notice. "-MP" adds a phony target per header so a deleted header does
# not wedge the build.
-include $(OBJS:.o=.d)

.PHONY: clean
