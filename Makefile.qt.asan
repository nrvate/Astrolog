# Astrolog (Version 8.00) File: Makefile.qt.asan
#
# Builds "astrolog-qt-asan": the test suite of Makefile.qt.test compiled
# with AddressSanitizer, at -O0 -g so the reports name real lines. Its own
# name and object directory, so it never clobbers either other build.
#
# Run it directly rather than through run-qt-tests.sh, and cap it:
#
#   make -f Makefile.qt.asan -j4
#   env -u DISPLAY QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME= \
#     ASAN_OPTIONS=detect_leaks=0 timeout 600 ./astrolog-qt-asan -i nrvate.as
#
# detect_leaks=0 because Qt does not free everything at exit and the leak
# report buries real findings. Minutes, not seconds. It has found four
# out-of-bounds bugs in Astrolog's own chart code so far, all silent
# without it. See "Finding memory bugs" in QT_TESTING.md.
#
NAME = astrolog-qt-asan
OBJDIR = obj-qt-asan
OBJS = $(OBJDIR)/astrolog.o $(OBJDIR)/atlas.o $(OBJDIR)/calc.o \
 $(OBJDIR)/charts0.o $(OBJDIR)/charts1.o $(OBJDIR)/charts2.o \
 $(OBJDIR)/charts3.o $(OBJDIR)/data.o $(OBJDIR)/express.o \
 $(OBJDIR)/general.o $(OBJDIR)/intrpret.o $(OBJDIR)/io.o \
 $(OBJDIR)/matrix.o $(OBJDIR)/placalc.o $(OBJDIR)/placalc2.o \
 $(OBJDIR)/xdata.o $(OBJDIR)/xgeneral.o $(OBJDIR)/xdevice.o \
 $(OBJDIR)/xcharts0.o $(OBJDIR)/xcharts1.o $(OBJDIR)/xcharts2.o \
 $(OBJDIR)/xscreen.o $(OBJDIR)/qtdriver.o $(OBJDIR)/qtdialog.o \
 $(OBJDIR)/qttest.o \
 $(OBJDIR)/swecl.o $(OBJDIR)/swedate.o $(OBJDIR)/swehouse.o \
 $(OBJDIR)/swejpl.o $(OBJDIR)/swemmoon.o $(OBJDIR)/swemplan.o \
 $(OBJDIR)/sweph.o $(OBJDIR)/swephlib.o

QT_CFLAGS = $(shell pkg-config --cflags Qt5Widgets Qt5Gui Qt5Core Qt5PrintSupport Qt5Network Qt5Test)
QT_LIBS = $(shell pkg-config --libs Qt5Widgets Qt5Gui Qt5Core Qt5PrintSupport Qt5Network Qt5Test)
LIBS = $(QT_LIBS) -lm -ldl -fsanitize=address
CPPFLAGS = -DQT -DQTTEST -fsanitize=address -g -O0 -fPIC -Wno-write-strings -Wno-narrowing \
 -Wno-comment $(QT_CFLAGS)
RM = rm -f

$(NAME): $(OBJDIR) $(OBJS)
	g++ -o $(NAME) $(OBJS) $(LIBS)

$(OBJDIR):
	mkdir -p $(OBJDIR)

# qtdialog.cpp includes the generated dialog tables; without this the
# object file survives a regeneration and the change appears to do nothing.
$(OBJDIR)/qtdialog.o: qtdialog.cpp qtrcdlg.h astrolog.h qtdriver.h

$(OBJDIR)/%.o: %.cpp
	g++ $(CPPFLAGS) -c -o $@ $<

clean:
	$(RM) -r $(OBJDIR)
	$(RM) $(NAME)
#
