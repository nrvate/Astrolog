# The source list, in one place instead of five.
#
# Every build in this tree compiles the same core and differs only in which
# backend it adds: the console/X11 one adds nothing, the three Qt ones add
# qtdriver.cpp and qtdialog.cpp (and qttest.cpp when the suite is compiled
# in), and the Windows one adds wdialog.cpp and wdriver.cpp. That was true
# before this file existed too -- it was just written out five times, and
# adding one source file meant editing five makefiles. Work log item 96
# records the day that bit: "five makefiles gained the object", one edit
# per file, and nothing in the tree would have noticed a missed one except
# a link error in whichever build was compiled last.
#
# So: add a source file here, once, in the group it belongs to. No makefile
# needs to change.
#
# The groups exist for one reason beyond tidiness -- they preserve each
# build's original link order exactly, so the four Linux binaries come out
# byte-for-byte identical to the hand-written lists they replaced. The
# Windows build listed the same files in a different order (alphabetical,
# with wdialog/wdriver in the middle), so its objects are ordered by these
# groups now; same set, same program, different layout.

# The engine: everything that computes a chart or reads and writes one.
# ephprom.cpp is the Prometheia source plugin (EPHEMERIS_PLUGINS_PLAN.md
# 4.2, phase 7): every build compiles it, and without -DPROMETHEIA it is
# empty, so the default build never references the library.
# ephhorizons.cpp is the JPL Horizons source (4.2, phase 6h), empty
# without JPLWEB for the same reason -- it is the fetcher's object
# mapping and has nothing to map without the fetcher.
SRC_CORE = astrolog.cpp switch.cpp atlas.cpp calc.cpp charts0.cpp \
  charts1.cpp charts2.cpp charts3.cpp data.cpp ephem.cpp ephswiss.cpp \
  ephhorizons.cpp ephprom.cpp ephserver.cpp express.cpp general.cpp \
  intrpret.cpp io.cpp matrix.cpp

# The graphics half: chart drawing and the device backends it draws to.
# cgif.cpp and cgif_raw.cpp are the vendored cgif library (MIT, see
# cgif-license.txt), which writes animated GIFs for xdevice.cpp. They sit
# here rather than in a group of their own because every build that
# compiles the graphics compiles them, and a new group is one that
# tools/qt-srcs.py and six makefiles would each have to learn about. They
# compile warning-free under g++ -Wall, mingw and clang, so unlike the
# Swiss files below they need no exemption.
SRC_GRAPHICS = xdata.cpp xgeneral.cpp xdevice.cpp xcharts0.cpp \
  xcharts1.cpp xcharts2.cpp xscreen.cpp cgif.cpp cgif_raw.cpp

# The Swiss Ephemeris library, vendored. Upstream's files, not this
# fork's -- see CLAUDE.md on sweph.cpp's line endings.
SRC_SWISS = swecl.cpp swedate.cpp swehouse.cpp swejpl.cpp swemmoon.cpp \
  swemplan.cpp sweph.cpp swephlib.cpp

# The three backends. Exactly one of QT and WIN is compiled into a binary;
# TEST rides along with QT when the in-process suite is wanted (-DQTTEST).
SRC_QT   = qtdriver.cpp qtdialog.cpp
SRC_TEST = qttest.cpp
SRC_WIN  = wdialog.cpp wdriver.cpp

# The vendored Swiss Ephemeris is compiled with two warning classes off:
# -Wwrite-strings (string literals into char *, 80-odd sites in sweph.cpp
# alone) and -Wsign-compare (two in search_star_in_list). They are
# upstream's code, held at SE_VERSION 2.10.03 so tools/swetest-oracle.sh
# compares like with like, and editing them to satisfy a warning would
# make every future comparison against upstream a diff first. The
# fork's own sources get no such exemption; tools/warning_audit.py holds
# them to zero. "override", because the audit passes CPPFLAGS or CFLAGS
# on the command line, which would otherwise take precedence over a
# target-specific assignment. Every object path a makefile here uses is
# named, so the one rule serves all of them; an unused form names files
# nothing builds, which make ignores.
#
# -Wno-deprecated-declarations is the third, and it is clang's: macOS
# marks sprintf(3) deprecated in its own headers, so Apple's compiler
# reported 254 of them across eight vendored files -- sweph.cpp 85,
# swephlib.cpp 62, swecl.cpp 36, swemplan.cpp 25, swejpl.cpp 20,
# swehouse.cpp 12, swemmoon.cpp and swedate.cpp 6 each -- and zero in
# this fork's own sources, which use sprintf2() (snprintf). Measured on
# the v8.00-qt.11 release run. gcc does not warn about it at all, so
# this changes nothing on Linux or mingw; it silences the class for the
# files nobody here may edit, and leaves it live for the files we do.
SWISS_NOWARN = -Wno-write-strings -Wno-sign-compare \
  -Wno-deprecated-declarations
SWISS_OBJS = $(patsubst %.cpp,%.o,$(SRC_SWISS)) \
  $(patsubst %.cpp,$(OBJDIR)/%.o,$(SRC_SWISS)) \
  $(patsubst %.cpp,$(ODIR)/%.o,$(SRC_SWISS))
$(SWISS_OBJS): override CPPFLAGS += $(SWISS_NOWARN)
$(SWISS_OBJS): override CFLAGS += $(SWISS_NOWARN)


# Ephemeris Prometheia is part of every product build since 2026-10-25,
# compiled from the submodule at PROMETHEIA_DIR by Makefile.prometheia,
# which each product makefile includes once it has its OBJDIR. It used to
# be an optional pkg-config dependency here, found on this machine and
# absent everywhere else -- so every build anyone else made, and every
# release, had no Prometheia in it at all.
PROMETHEIA_DIR ?= prometheia
# PROMETHEIA_HOME is a different thing: a FULL Prometheia checkout, with
# the daemon built and the kernels fetched, which the submodule has
# neither of. The suite's live server legs start prometheiad from it over
# its own kernels (qttest.cpp, FPromdArgsQt), so the three test makefiles
# compile its path in, and the legs skip, saying why, when it is not
# there. A sibling by default; "make PROMETHEIA_HOME=/path" names another.
PROMETHEIA_HOME ?= /shares/ephemeris-prometheia
PROMETHEIA_TEST_FLAGS := -DPROMETHEIA_HOME_DIR='"$(PROMETHEIA_HOME)"'

# PROMETHEIA_FLAGS is decided at parse time (Makefile.prometheia), and a
# change of it changes no source file's mtime -- so make happily links an
# ephem.o compiled without the plugin, or against another checkout's
# headers, beside a plugin-built ephprom.o, and the registry row is
# silently absent (the trap the phase 7 review hit by hand; the move from
# pkg-config to the submodule is exactly such a change). Each including
# makefile calls the stamp below with its object dir: the dir
# remembers the flags it was last built with, and a change -- or
# pre-stamp objects with no record to compare -- deletes the three
# objects the flag can reach, before make has considered them. The
# command is silent on success by design; its output is makefile text
# the moment $(shell) returns it.
define prometheia-stamp
$(shell d='$(1)'; [ -n "$$d" ] || d=.; stamp="$$d/.prometheia-stamp"; \
  mkdir -p "$$d" 2>/dev/null; \
  if [ -f "$$d/ephem.o" ] || [ -f "$$d/ephprom.o" ] || [ -f "$$d/qttest.o" ]; then \
    cur='$(PROMETHEIA_FLAGS)'; old=`cat "$$stamp" 2>/dev/null`; \
    if [ ! -f "$$stamp" ] || [ x"$$cur" != x"$$old" ]; then \
      echo "Makefile.srcs: PROMETHEIA state changed; rebuilding ephprom.o ephem.o qttest.o in $$d" >&2; \
      rm -f "$$d/ephem.o" "$$d/ephprom.o" "$$d/qttest.o" \
            "$$d/ephem.d" "$$d/ephprom.d" "$$d/qttest.d"; \
    fi; \
  fi; \
  printf '%s\n' '$(PROMETHEIA_FLAGS)' > "$$stamp" 2>/dev/null || true)
endef
