# The source list, in one place instead of five.
#
# Every build in this tree compiles the same core and differs only in which
# backend it adds: the console/X11 one adds nothing, the three Qt ones add
# qtdriver.cpp and qtdialog.cpp (and qttest.cpp when the suite is compiled
# in), and the Windows one adds wdialog.cpp and wdriver.cpp. That was true
# before this file existed too -- it was just written out five times, and
# adding one source file meant editing five makefiles. Work log item 96
# records the day that bit: "five makefiles gained the object", one edit
# per file, and nothing in the tree would have noticed a missed one except
# a link error in whichever build was compiled last.
#
# So: add a source file here, once, in the group it belongs to. No makefile
# needs to change.
#
# The groups exist for one reason beyond tidiness -- they preserve each
# build's original link order exactly, so the four Linux binaries come out
# byte-for-byte identical to the hand-written lists they replaced. The
# Windows build listed the same files in a different order (alphabetical,
# with wdialog/wdriver in the middle), so its objects are ordered by these
# groups now; same set, same program, different layout.

# The engine: everything that computes a chart or reads and writes one.
# ephprom.cpp is the Prometheia source plugin (EPHEMERIS_PLUGINS_PLAN.md
# 4.2, phase 7): every build compiles it, and without -DPROMETHEIA it is
# empty, so the default build never references the library.
# ephhorizons.cpp is the JPL Horizons source (4.2, phase 6h), empty
# without JPLWEB for the same reason -- it is the fetcher's object
# mapping and has nothing to map without the fetcher.
SRC_CORE = astrolog.cpp switch.cpp atlas.cpp calc.cpp charts0.cpp \
  charts1.cpp charts2.cpp charts3.cpp data.cpp ephem.cpp ephswiss.cpp \
  ephhorizons.cpp ephprom.cpp ephserver.cpp express.cpp general.cpp \
  intrpret.cpp io.cpp matrix.cpp

# The graphics half: chart drawing and the device backends it draws to.
# cgif.cpp and cgif_raw.cpp are the vendored cgif library (MIT, see
# cgif-license.txt), which writes animated GIFs for xdevice.cpp. They sit
# here rather than in a group of their own because every build that
# compiles the graphics compiles them, and a new group is one that
# tools/qt-srcs.py and six makefiles would each have to learn about. They
# compile warning-free under g++ -Wall, mingw and clang, so unlike the
# Swiss files below they need no exemption.
SRC_GRAPHICS = xdata.cpp xgeneral.cpp xdevice.cpp xcharts0.cpp \
  xcharts1.cpp xcharts2.cpp xscreen.cpp cgif.cpp cgif_raw.cpp

# The Swiss Ephemeris library, vendored. Upstream's files, not this
# fork's -- see CLAUDE.md on sweph.cpp's line endings. The four Linux Qt
# builds compile them only with SWE=bundled, and link the installed
# thread-safe fork's libswe.so instead where it is there: see the end of
# this file.
SRC_SWISS = swecl.cpp swedate.cpp swehouse.cpp swejpl.cpp swemmoon.cpp \
  swemplan.cpp sweph.cpp swephlib.cpp

# The three backends. Exactly one of QT and WIN is compiled into a binary;
# TEST rides along with QT when the in-process suite is wanted (-DQTTEST).
SRC_QT   = qtdriver.cpp qtdialog.cpp
SRC_TEST = qttest.cpp
SRC_WIN  = wdialog.cpp wdriver.cpp

# The ephemeris WebSocket server (branch ephserver, EPHEMERIS_SERVER_PLAN.md)
# and the standalone wire client its gates drive. Unlike every other binary
# in the tree these compile NONE of the engine and link the Swiss Ephemeris
# thread-safe fork's library in place of the vendored SRC_SWISS files --
# concurrent requests need the fork's swe_ctx API, which upstream 2.10.03
# does not have, and the vendored copy stays untouched for the
# swetest-oracle tooling. Makefile.ephsrv is the only build that compiles
# this group; its SWE_HOME variable says where the fork lives.
SRC_EPHSRV = ephsrv/eph_srv.cpp ephsrv/eph_wsclient.cpp

# The vendored Swiss Ephemeris is compiled with two warning classes off:
# -Wwrite-strings (string literals into char *, 80-odd sites in sweph.cpp
# alone) and -Wsign-compare (two in search_star_in_list). They are
# upstream's code, held at SE_VERSION 2.10.03 so tools/swetest-oracle.sh
# compares like with like, and editing them to satisfy a warning would
# make every future comparison against upstream a diff first. The
# fork's own sources get no such exemption; tools/warning_audit.py holds
# them to zero. "override", because the audit passes CPPFLAGS or CFLAGS
# on the command line, which would otherwise take precedence over a
# target-specific assignment. Every object path a makefile here uses is
# named, so the one rule serves all of them; an unused form names files
# nothing builds, which make ignores.
#
# -Wno-deprecated-declarations is the third, and it is clang's: macOS
# marks sprintf(3) deprecated in its own headers, so Apple's compiler
# reported 254 of them across eight vendored files -- sweph.cpp 85,
# swephlib.cpp 62, swecl.cpp 36, swemplan.cpp 25, swejpl.cpp 20,
# swehouse.cpp 12, swemmoon.cpp and swedate.cpp 6 each -- and zero in
# this fork's own sources, which use sprintf2() (snprintf). Measured on
# the v8.00-qt.11 release run. gcc does not warn about it at all, so
# this changes nothing on Linux or mingw; it silences the class for the
# files nobody here may edit, and leaves it live for the files we do.
SWISS_NOWARN = -Wno-write-strings -Wno-sign-compare \
  -Wno-deprecated-declarations
SWISS_OBJS = $(patsubst %.cpp,%.o,$(SRC_SWISS)) \
  $(patsubst %.cpp,$(OBJDIR)/%.o,$(SRC_SWISS)) \
  $(patsubst %.cpp,$(ODIR)/%.o,$(SRC_SWISS))
$(SWISS_OBJS): override CPPFLAGS += $(SWISS_NOWARN)
$(SWISS_OBJS): override CFLAGS += $(SWISS_NOWARN)


# The Prometheia source plugin's optional dependency (EPHEMERIS_PLUGINS_
# PLAN.md 4.2, phase 7): detected with `pkg-config prometheia`, and
# built without it silently -- PROMETHEIA_FLAGS and PROMETHEIA_LIBS come
# out empty, ephprom.cpp compiles empty, and no binary references the
# library. The source then reports unavailable through FAvailable. The
# Windows toolchains get no detection at all: the package is today a
# Linux static library, and a .pc on a mingw PATH would hand this build
# Linux paths. A makefile opts in with the two lines after its own
# CPPFLAGS and LIBS:
#
#   CPPFLAGS += $(PROMETHEIA_FLAGS)
#   LIBS += $(PROMETHEIA_LIBS)
#
# PROMETHEIA_HOME is where a Prometheia checkout lives, found the way
# SWE_HOME finds the Swiss fork: a sibling by default, overridable with
# "make PROMETHEIA_HOME=/path". Its build tree's prometheia.pc is appended
# to whatever PKG_CONFIG_PATH the user already has, so an installed
# Prometheia still wins and a checkout without the sibling builds as before.
PROMETHEIA_HOME ?= /shares/ephemeris-prometheia
PROMETHEIA_PKGCONFIG := PKG_CONFIG_PATH="$(PKG_CONFIG_PATH)$(if $(PKG_CONFIG_PATH),:)$(PROMETHEIA_HOME)/build" pkg-config
UNAME := $(shell uname -s 2>/dev/null)
ifneq ($(findstring Linux,$(UNAME)),Linux)
PROMETHEIA_FOUND :=
else
PROMETHEIA_FOUND := $(shell $(PROMETHEIA_PKGCONFIG) --exists prometheia 2>/dev/null && echo yes)
endif
PROMETHEIA_FLAGS := $(if $(PROMETHEIA_FOUND),-DPROMETHEIA $(shell $(PROMETHEIA_PKGCONFIG) --cflags prometheia 2>/dev/null))
PROMETHEIA_LIBS := $(if $(PROMETHEIA_FOUND),$(shell $(PROMETHEIA_PKGCONFIG) --static --libs prometheia 2>/dev/null))

# That decision is made here, at parse time, and a flip of it changes no
# source file's mtime -- so make happily links an ephem.o compiled
# without the plugin beside a plugin-built ephprom.o, and the registry
# row is silently absent (the trap the phase 7 review hit by hand). Each
# opting-in makefile calls the stamp below with its object dir: the dir
# remembers the flags it was last built with, and a change -- or
# pre-stamp objects with no record to compare -- deletes the three
# objects the flag can reach, before make has considered them. The
# command is silent on success by design; its output is makefile text
# the moment $(shell) returns it.
define prometheia-stamp
$(shell d='$(1)'; [ -n "$$d" ] || d=.; stamp="$$d/.prometheia-stamp"; \
  mkdir -p "$$d" 2>/dev/null; \
  if [ -f "$$d/ephem.o" ] || [ -f "$$d/ephprom.o" ] || [ -f "$$d/qttest.o" ]; then \
    cur='$(PROMETHEIA_FLAGS)'; old=`cat "$$stamp" 2>/dev/null`; \
    if [ ! -f "$$stamp" ] || [ x"$$cur" != x"$$old" ]; then \
      echo "Makefile.srcs: PROMETHEIA state changed; rebuilding ephprom.o ephem.o qttest.o in $$d" >&2; \
      rm -f "$$d/ephem.o" "$$d/ephprom.o" "$$d/qttest.o" \
            "$$d/ephem.d" "$$d/ephprom.d" "$$d/qttest.d"; \
    fi; \
  fi; \
  printf '%s\n' '$(PROMETHEIA_FLAGS)' > "$$stamp" 2>/dev/null || true)
endef


# Which Swiss Ephemeris the four Linux Qt builds use: SWE=system or
# SWE=bundled (work log item 285 in QT_GUI_PLAN.md).
#
#   system   links the installed thread-safe fork's shared library,
#            libswe.so (found with `pkg-config swe`), compiles none of
#            SRC_SWISS, and compiles against the fork's own headers. It is
#            what this program actually runs on a machine that has the
#            fork, so Help > About can name it: "Swiss Ephemeris
#            2.10.03-ts.19, from /usr/local/lib/libswe.so".
#   bundled  compiles the vendored SRC_SWISS files into the executable, as
#            every build did before. Every other makefile here (console,
#            Windows, ephsrv) always does this or its own thing and never
#            reads SWE.
#
# The default is system wherever it CAN work, bundled elsewhere -- a stock
# checkout, a CI runner, macOS -- so nothing that built before stops
# building. "make qt SWE=system" refuses, with the reason, where it cannot
# work; "make qt SWE=bundled" forces the old build on a machine that has
# the fork. A machine with a swe.pc that is not usable gets a warning
# naming why, rather than a silent fall back to the vendored copy, which is
# the failure the About line was misreporting in the first place.
#
# Three things have to hold, because Astrolog uses more of the library
# than its public API. calc.cpp and the shared ephsrv/ephsidplane.h,
# ephstarorb.h and ephnodrate.h call swi_precess(), swi_epsiln(),
# swi_nutation() and swi_bias() and use sweph.h's J2000 and SSY_PLANE_*
# constants. The fork exports those functions from libswe.so, but with a
# context argument the vendored ones do not take, and it installs only the
# public headers. So the internal headers come from the fork's checkout,
# SWE_HOME, as Makefile.ephsrv's do, and the checkout must be the version
# that is installed -- a mismatch is a prototype that does not match the
# library it links, which compiles and links and then reads the wrong
# arguments.
#   1. pkg-config finds swe, and its swe_full_version is the fork's
#      ("-ts." in it): upstream's library has no context-taking swi_*.
#   2. $(SWE_HOME)/sweph.h and swephlib.h exist.
#   3. That sweph.h's SE_VERSION is swe_full_version, exactly.
#
# The public header is not reached by include path at all. Every file that
# says #include "swephexp.h" finds the vendored ./swephexp.h first -- the
# quote form searches the including file's own directory before any -I --
# and /usr/local/include is a system directory, which gcc will not move
# ahead of "-I ." however it is asked. So the system build names the
# installed header by absolute path with -include, ahead of everything;
# it and the vendored one share their include guard (_SWEPHEXP_INCLUDED,
# and _SWEODEF_INCLUDED for sweodef.h), so every later "swephexp.h" is a
# no-op. The two internal headers are included by calc.cpp alone, by the
# absolute paths in SWE_SYSTEM_SWEPH_H and SWE_SYSTEM_SWEPHLIB_H.
SWE_HOME ?= /shares/swisseph
ifneq ($(findstring Linux,$(UNAME)),Linux)
SWE_PC_FULL :=
SWE_WHYNOT := only the Linux builds link the system library
else
SWE_PC_FULL := $(shell pkg-config --variable=swe_full_version swe 2>/dev/null)
SWE_PC_INC := $(shell pkg-config --variable=includedir swe 2>/dev/null)
SWE_HOME_FULL := $(shell sed -n 's/.*define SE_VERSION *"\([^"]*\)".*/\1/p' '$(SWE_HOME)/sweph.h' 2>/dev/null)
SWE_WHYNOT := $(strip \
  $(if $(SWE_PC_FULL),,pkg-config finds no swe package (the thread-safe fork installs swe.pc)) \
  $(if $(SWE_PC_FULL),$(if $(findstring -ts.,$(SWE_PC_FULL)),,the installed swe is $(SWE_PC_FULL), not the thread-safe fork)) \
  $(if $(SWE_PC_FULL),$(if $(wildcard $(SWE_PC_INC)/swephexp.h),,no swephexp.h in $(SWE_PC_INC))) \
  $(if $(findstring -ts.,$(SWE_PC_FULL)),$(if $(wildcard $(SWE_HOME)/sweph.h $(SWE_HOME)/swephlib.h),,no sweph.h and swephlib.h in SWE_HOME=$(SWE_HOME))) \
  $(if $(and $(findstring -ts.,$(SWE_PC_FULL)),$(SWE_HOME_FULL)),$(if $(filter $(SWE_PC_FULL),$(SWE_HOME_FULL)),,the installed library is $(SWE_PC_FULL) but $(SWE_HOME) is $(SWE_HOME_FULL))))
endif
ifeq ($(origin SWE),undefined)
SWE_AUTO := yes
SWE := $(if $(SWE_WHYNOT),bundled,system)
endif
#
# SWE_FALLBACK applies to the system build only. The fork answers a
# position its data files do not cover with an error, where upstream (and
# so the bundled build) answers from Moshier and says so; 1, the default,
# asks the fork for upstream's behaviour, which is what Astrolog was written
# against, and 0 keeps the fork's refusal. calc.cpp's SwissEnsurePath()
# makes the call.
SWE_FALLBACK ?= 1
ifeq ($(SWE),system)
ifeq ($(filter 0 1,$(SWE_FALLBACK)),)
$(error SWE_FALLBACK=$(SWE_FALLBACK): say 1 (Moshier answers what the files do not cover) or 0 (an error))
endif
SWE_FLAGS := -DSWE_SYSTEM -include $(SWE_PC_INC)/swephexp.h \
  -DSWE_SYSTEM_SWEPH_H='"$(SWE_HOME)/sweph.h"' \
  -DSWE_SYSTEM_SWEPHLIB_H='"$(SWE_HOME)/swephlib.h"' \
  -DSWE_EPHE_FALLBACK=$(SWE_FALLBACK)
SWE_LIBS := $(shell pkg-config --libs swe 2>/dev/null)
SWE_STAMP := system $(SWE_PC_FULL) $(SWE_PC_INC) $(SWE_HOME) fallback=$(SWE_FALLBACK)
else
SWE_FLAGS :=
SWE_LIBS :=
SWE_STAMP := bundled
endif

# Called by each Qt makefile as $(eval $(call swe-select,$(OBJDIR))),
# after its own CPPFLAGS and LIBS: it refuses an SWE that cannot be built,
# warns where the fork is half there, and makes every object depend on
# $(OBJDIR)/.swe-stamp, which holds the choice and is rewritten only when
# the choice changes -- gitsha.h's pattern -- so a flip of SWE (or a new
# installed version, or SWE_FALLBACK) recompiles the whole dir: the
# -include reaches every translation unit, and nothing else would notice.
#
# A prerequisite, not prometheia-stamp's delete at parse time, because the
# audits read this makefile without building it: tools/warning_audit.py
# asks it for its flags with no OBJDIR, under SWE=bundled, and a delete at
# parse time emptied obj-qt/ every time it did. A rule only runs when an
# object is actually being built. The .DEFAULT_GOAL dance keeps the stamp
# rule from becoming the makefile's default target, which the first rule
# in a makefile otherwise is. The "+" runs the recipe under make -n
# too: a dry run that cannot see the stamp is unchanged assumes it changed
# and lists every object as out of date, which is what
# tools/stale-object-check.sh reads.
define swe-select
ifeq ($$(filter system bundled,$$(SWE)),)
$$(error SWE=$$(SWE): say SWE=system or SWE=bundled)
endif
ifeq ($$(SWE)$$(if $$(SWE_WHYNOT),x),systemx)
$$(error SWE=system cannot be built here: $$(SWE_WHYNOT). SWE=bundled compiles the vendored copy)
endif
ifeq ($$(SWE_AUTO)$$(SWE)$$(if $$(SWE_PC_FULL),x),yesbundledx)
$$(warning Makefile.srcs: building with the vendored Swiss Ephemeris, not the installed $$(SWE_PC_FULL): $$(SWE_WHYNOT))
endif
SWE_GOAL_SAVED := $$(.DEFAULT_GOAL)
$(1)/.swe-stamp: FORCE | $(1)
	+@printf '%s\n' '$$(SWE_STAMP)' > $$@.tmp; \
	  cmp -s $$@.tmp $$@ 2>/dev/null || mv $$@.tmp $$@; rm -f $$@.tmp
$$(OBJS): $(1)/.swe-stamp
.DEFAULT_GOAL := $$(SWE_GOAL_SAVED)
endef
