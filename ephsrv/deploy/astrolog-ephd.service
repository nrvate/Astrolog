# systemd unit for astrolog-ephd on a plain host (production plan Phase 5).
#
# Install (ephsrv/deploy/README.md has the whole sequence):
#   useradd --system --no-create-home --shell /usr/sbin/nologin astrolog-ephd
#   install -m 0755 astrolog-ephd /usr/local/bin/
#   install -m 0644 ephsrv/deploy/astrolog-ephd.service /etc/systemd/system/
#   systemctl enable --now astrolog-ephd
#
# Serves wss:// on 443 from the certificate the certbot deploy hook
# (ephsrv/deploy/certbot-deploy-hook) copies into /etc/astrolog-ephd/tls and
# reloads with `systemctl reload`, which is SIGHUP: new handshakes get the
# new certificate, connections stay up. `systemctl stop` is SIGTERM, which
# drains; TimeoutStopSec is past --drain-seconds' default 10.
#
# Extra options (limits, tokens, threads) go in EPHD_ARGS in
# /etc/default/astrolog-ephd, e.g.
#   EPHD_ARGS=--cells-per-sec 20000 --tokens /etc/astrolog-ephd/tokens

[Unit]
Description=Astrolog ephemeris server (astrolog-ephd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astrolog-ephd
Group=astrolog-ephd
EnvironmentFile=-/etc/default/astrolog-ephd
ExecStart=/usr/local/bin/astrolog-ephd --port 443 \
  --ephe /var/lib/astrolog-ephd/ephe \
  --tls-cert /etc/astrolog-ephd/tls/fullchain.pem \
  --tls-key /etc/astrolog-ephd/tls/privkey.pem \
  $EPHD_ARGS
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

# 443 without root, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# The server writes nothing: its data and certificates are read-only, its
# log is stdout, which journald takes.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# One descriptor a connection plus the ephemeris files each loop opens;
# --max-conns defaults to 10000.
LimitNOFILE=65536
MemoryMax=4G

[Install]
WantedBy=multi-user.target
