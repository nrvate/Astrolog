# Astrolog (Version 8.00) File: Makefile.qt (Linux/Qt GUI version)
#
# IMPORTANT NOTICE: Astrolog and all chart display routines and anything
# not enumerated elsewhere in this program are Copyright (C) 1991-2026 by
# Walter D. Pullen (Astara@msn.com, http://www.astrolog.org/astrolog.htm).
# Permission is granted to freely use, modify, and distribute these
# routines provided these credits and notices remain unmodified with any
# altered or distributed versions of the program.
#
# This builds the Qt based Linux GUI backend, an alternative to the plain
# X11 GUI the regular Makefile builds (real menus and dialogs instead of
# single letter keystroke commands). It compiles the same shared core as
# the X11 build, with "-DQT" overriding astrolog.h's default X11 backend
# selection, plus qtdriver.cpp/qtdialog.cpp in place of wdialog.cpp/
# wdriver.cpp (the Windows-only dialog/menu layer). Object files go in
# obj-qt/ so this can be built alongside the regular "astrolog" binary
# without either one clobbering the other's object files.
#
# Requires the Qt5 development headers/libraries (e.g. the "qtbase5-dev"
# package on Debian/Ubuntu).
#
NAME = astrolog-qt
OBJDIR = obj-qt
# The source list lives in one file for every build; see the header
# there before adding a source.
include Makefile.srcs
OBJS = $(patsubst %.cpp,$(OBJDIR)/%.o,\
  $(SRC_CORE) $(SRC_GRAPHICS) $(SRC_QT) $(SRC_SWISS))

# Build against whichever Qt this machine has: Qt6 when pkg-config knows
# about it, Qt5 otherwise. One command works on a stock Ubuntu (Qt5), on a
# newer distro, and on a CI runner with either -- which is the whole point,
# since the alternative is a build matrix that doubles CI time to prove
# something the version guards already handle.
#
# Override explicitly with "make -f Makefile.qt QT_MAJOR=5" to force one.
# Qt6 lives outside the default pkg-config path when installed by hand, so
# it is opt-in: PKG_CONFIG_PATH=/usr/local/qt6/lib/pkgconfig selects it.
QT_MAJOR := $(shell pkg-config --exists Qt6Widgets && echo 6 || echo 5)
QT_MODULES = Qt$(QT_MAJOR)Widgets Qt$(QT_MAJOR)Gui Qt$(QT_MAJOR)Core \
 Qt$(QT_MAJOR)PrintSupport Qt$(QT_MAJOR)Network
# Stop by name when Qt is not installed, before anything compiles.
# Without this, pkg-config prints three lines of its own advice per
# missing module -- "add the directory containing `Qt5Widgets.pc' to
# PKG_CONFIG_PATH", which is the wrong fix when the package simply is
# not installed -- and then the build carries on with QT_CFLAGS empty,
# so what actually reaches the user is
#
#     qtdriver.cpp:39:10: fatal error: QtCore/qglobal.h: No such file
#
# twenty lines below the cause, and further still under -j4. Measured
# on 2026-09-01 with PKG_CONFIG_LIBDIR pointed at nothing.
#
# "clean" alone is exempt: removing object files must not need Qt. Any
# other goal, or none, wants the guard -- hence the $(if), which reads
# an empty MAKECMDGOALS as "the default goal", not as "nothing to do".
QT_NEEDED := $(if $(MAKECMDGOALS),$(filter-out clean,$(MAKECMDGOALS)),default)
ifneq ($(QT_NEEDED),)
QT_FOUND := $(shell pkg-config --exists $(QT_MODULES) 2>/dev/null && echo yes)
ifneq ($(QT_FOUND),yes)
$(error Qt development files not found. pkg-config cannot find: \
$(strip $(foreach m,$(QT_MODULES),\
$(if $(shell pkg-config --exists $(m) 2>/dev/null && echo y),,$(m)))). \
On Debian/Ubuntu: sudo apt install \
$(if $(filter 6,$(QT_MAJOR)),qt6-base-dev,qtbase5-dev). If Qt is installed \
somewhere pkg-config does not look, set PKG_CONFIG_PATH to the \
directory holding its .pc files. See CLAUDE.md, "Prerequisites")
endif
endif

QT_CFLAGS = $(shell pkg-config --cflags $(QT_MODULES) 2>/dev/null)
QT_LIBS = $(shell pkg-config --libs $(QT_MODULES) 2>/dev/null)
LIBS = $(QT_LIBS) -lm -ldl
CPPFLAGS = -MMD -MP -DQT -O -fPIC -std=gnu++17 -Wno-write-strings -Wno-narrowing -Wno-comment \
 $(QT_CFLAGS)
RM = rm -f

$(NAME): $(OBJS)
# LDEXTRA is empty for every ordinary build and exists for one case:
# a hand-installed Qt6 whose libraries are not on the runtime linker
# path, where the top-level "make qt6" passes an -rpath through it.
	g++ -o $(NAME) $(OBJS) $(LIBS) $(LDEXTRA)

$(OBJDIR):
	mkdir -p $(OBJDIR)

# qtdialog.cpp includes the generated dialog tables; without this the
# object file survives a regeneration and the change appears to do nothing.

# Same reason for the generated accelerator table: without this the
# object file survives a regeneration and the change looks inert.


# "| $(OBJDIR)" is an ORDER-ONLY prerequisite, and it has to be here
# rather than on $(NAME). Listing $(OBJDIR) among $(NAME)'s ordinary
# prerequisites does not order it before the objects: under -j make is
# free to start compiling into a directory the mkdir has not created
# yet, and "make clean-all && make all -j4" did exactly that --
# "Fatal error: can't create obj-qt-test/sweph.o: No such file or
# directory". Makefile.win had it right all along.
$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
	g++ $(CPPFLAGS) -c -o $@ $<

clean:
	$(RM) -r $(OBJDIR)
	$(RM) $(NAME)
#

# Header dependencies are generated by the compiler, not maintained by
# hand. "-MMD -MP" writes a .d file beside each object listing every header
# it actually included, and the "-include" below feeds them back in.
#
# The hand-written version tracked exactly two headers, astrolog.h and
# extern.h, so touching swephexp.h rebuilt NOTHING and left
# objects that did not match their source -- measured, not supposed. That
# is the stale-binary class CLAUDE.md warns about ("if a check claims to
# have rebuilt something, look at the binary's timestamp"), with no check
# to notice. "-MP" adds a phony target per header so a deleted header does
# not wedge the build.
-include $(OBJS:.o=.d)

.PHONY: clean
