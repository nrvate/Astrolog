# Cross compile the Windows build of Astrolog with mingw-w64, so it can be
# run under Wine on Linux and compared side by side against the Qt build.
# This produces the same program a Windows user runs -- same wdriver.cpp,
# same wdialog.cpp, same astrolog.rc -- rather than an approximation of it.
#
#   make -f Makefile.win
#   wine ./astrolog.exe
#
# IDC_STATIC is an MFC symbol that windres doesn't define but the resource
# script uses throughout; -1 is the value Visual Studio gives it.

CXX    = x86_64-w64-mingw32-g++
RC     = x86_64-w64-mingw32-windres
ODIR   = obj-win
# __CRT__NO_INLINE: mingw's <io.h> has inline functions with a local named
# "ret", which extern.h defines as a macro (cp0.dir); disabling those inlines
# avoids the collision without touching shared code.
# min/max are restored by wincompat.h, included at the end of astrolog.h --
# they can't be defined on the command line because libstdc++'s c++config.h
# undefines them partway through the include chain.
#
# This used to say "-w", which silences every diagnostic. wdriver.cpp and
# wdialog.cpp are compiled by no other makefile in the tree, so that one
# flag left them the only two source files here that nothing had ever
# diagnosed. Replaced 2026-09-01 with the same three suppressions the
# Linux makefiles carry, which is all -w was actually needed for: with
# those three, this build reports zero warnings at the default level.
#
# -std=gnu++17 comes with it, and is not optional. mingw g++ 10 defaults to
# gnu++14, where calc.cpp's "Borrow bciCore(ciCore);" -- class template
# argument deduction, a C++17 feature the Linux builds get for free from
# g++ 11's default -- is a hard error. -fpermissive downgraded it and -w
# then swallowed the message, which is how it went unnoticed.
CFLAGS = -DWIN -DPC -D_WINDOWS -DWIN32 -D__CRT__NO_INLINE \
         -O2 -fpermissive -static -std=gnu++17 \
         -Wno-write-strings -Wno-narrowing -Wno-comment -MMD -MP
LIBS   = -lgdi32 -lcomdlg32 -lcomctl32 -lshell32 -lole32 -luuid -lwinspool \
         -ladvapi32 -luser32 -lkernel32 -lwinmm -lmswsock -lws2_32 -lurlmon
LDFLAGS = -mwindows -static -static-libgcc -static-libstdc++

# The source list lives in one file for every build; see the header
# there before adding a source. This build orders its objects by those
# groups rather than the alphabetical order it used to spell out; same
# set of files, different link layout.
include Makefile.srcs
SRC = $(SRC_CORE) $(SRC_SWISS) $(SRC_WIN) $(SRC_GRAPHICS)

OBJ = $(patsubst %.cpp,$(ODIR)/%.o,$(SRC))

astrolog.exe: $(OBJ) $(ODIR)/astrolog.res
	$(CXX) $(LDFLAGS) -o $@ $(OBJ) $(ODIR)/astrolog.res $(LIBS)


$(ODIR)/%.o: %.cpp | $(ODIR)
	$(CXX) $(CFLAGS) -c $< -o $@

$(ODIR)/astrolog.res: astrolog.rc resource.h | $(ODIR)
	$(RC) -I. -DIDC_STATIC=-1 -O coff $< $@

$(ODIR):
	mkdir -p $(ODIR)

clean:
	rm -rf $(ODIR) astrolog.exe

# Compiler-generated header dependencies; see Makefile.qt.
-include $(OBJ:.o=.d)

.PHONY: clean
