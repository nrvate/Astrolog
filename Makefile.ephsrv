# Astrolog (Version 8.00) File: Makefile.ephsrv (ephemeris WebSocket server)
#
# IMPORTANT NOTICE: Astrolog and all chart display routines and anything
# not enumerated elsewhere in this program are Copyright (C) 1991-2026 by
# Walter D. Pullen (Astara@msn.com, http://www.astrolog.org/astrolog.htm).
# Permission is granted to freely use, modify, and distribute these
# routines provided these credits and notices remain unmodified with any
# altered or distributed versions of the program.
#
# This builds astrolog-ephd, the ephemeris WebSocket service (branch
# ephserver, EPHEMERIS_SERVER_PLAN.md), and eph_wsclient, the standalone
# wire client its gates drive. It compiles NONE of the engine: unlike
# every other binary in the tree it links the Swiss Ephemeris thread-safe
# fork's library in place of the vendored SRC_SWISS files, because
# concurrent requests need the fork's swe_ctx API, which upstream 2.10.03
# does not have. The vendored copy stays untouched for the
# swetest-oracle tooling. Objects go in obj-ephsrv/ so this can be built
# alongside everything else without clobbering anything.
#
# Prerequisites, both built by the "ephsrv" target below when missing:
#   the uSockets static library (vendored, ephsrv/uSockets) and the
#   thread-safe fork's libswe.a ("cd $(SWE_HOME) && make libswe.a").
#
# SWE_HOME is where the fork lives. Overridable on the command line the
# same way QT6_LIBDIR is: "make -f Makefile.ephsrv SWE_HOME=/path".
#
NAME = astrolog-ephd
CLIENT = eph_wsclient
OBJDIR = obj-ephsrv
SWE_HOME ?= /shares/swisseph
include Makefile.srcs
# The client is not part of the server binary: both have a main(), so
# eph_wsclient is filtered out of the server's objects and linked on its
# own below.
OBJS = $(patsubst %.cpp,$(OBJDIR)/%.o,$(filter-out ephsrv/eph_wsclient.cpp,$(SRC_EPHSRV)))

# uSockets builds with OpenSSL when the headers are present; the server
# needs no TLS for a localhost-first deployment, but the vendored default
# build is WITH_OPENSSL=1 and the link list matches it.
LIBS = ephsrv/uSockets/uSockets.a -L$(SWE_HOME) -lswe -lssl -lcrypto \
 -lz -lpthread -lm -ldl
CPPFLAGS = -MMD -MP -O2 -std=gnu++17 -I ephsrv/uWebSockets/src \
 -I ephsrv/uSockets/src -I ephsrv -I $(SWE_HOME)
RM = rm -f

$(NAME): $(OBJS) ephsrv/uSockets/uSockets.a
	g++ -o $(NAME) $(OBJS) $(LIBS)

$(CLIENT): $(OBJDIR)/eph_wsclient.o
	g++ -o $(CLIENT) $(OBJDIR)/eph_wsclient.o

$(OBJDIR)/eph_wsclient.o: ephsrv/eph_wsclient.cpp | $(OBJDIR)
	g++ $(CPPFLAGS) -c -o $@ $<

ephsrv/uSockets/uSockets.a:
	$(MAKE) -C ephsrv/uSockets WITH_OPENSSL=1

$(OBJDIR):
	mkdir -p $(OBJDIR)

# $(dir $@) because SRC_EPHSRV lives under ephsrv/, one level deeper than
# OBJDIR: the order-only | $(OBJDIR) mkdir covers the first level only.
$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
	@mkdir -p $(dir $@)
	g++ $(CPPFLAGS) -c -o $@ $<

clean:
	$(RM) -r $(OBJDIR)
	$(RM) $(NAME) $(CLIENT)

# Header dependencies are generated by the compiler, not maintained by
# hand; see Makefile.qt's tail for the full story of -MMD -MP, the
# -include, and why a missing .d must count as just remade.
-include $(OBJS:.o=.d)
$(OBJS:.o=.d):
$(OBJS): %.o: %.d

.PHONY: clean
